{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@neatly/ui": ["../../packages/ui/src"],
      "@neatly/ui/tokens": ["../../packages/ui/src/tokens"],
      "@neatly/ui/components": ["../../packages/ui/src/components"],
      "@neatly/ui/services": ["../../packages/ui/src/services"],
      "@neatly/i18n": ["../../packages/i18n/src"],
      "@neatly/domain": ["../../packages/domain/src"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "vite.config.ts"]
}
