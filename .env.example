# Neatly — Space Care App
# Level 1 environment configuration
# Copy this file to .env and fill in your own values.

# Supabase (Level 1: empty baseline migration; connection used later)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App
VITE_APP_NAME=Neatly
VITE_APP_VERSION=0.1.0

# Feature flags (off by default; Level 1 only reads them)
VITE_FEATURE_PUBLIC_REPORTING=false
VITE_FEATURE_INVENTORY=false
